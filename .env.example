# ---------------------------------------------------------------
# 腾讯云混元生3D + COS 接入环境变量
# 复制本文件为 .env 并填入真实值。不要把 .env 提交到仓库。
# ---------------------------------------------------------------

# 必填（ai3d 提交/查询鉴权；也复用给 COS 上传）
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENTCLOUD_REGION=ap-guangzhou

# 图片上传方式：submit 的 ImageUrl / MultiViewImages 必须公网可访问。
# 本地 api/<sku>/ 图先上传到 COS 再拿 URL。缺 COS 桶会提交失败。
# 桶名形如 my-bucket-1250000000（含 APPID 后缀）。
TENCENTCLOUD_COS_BUCKET=
TENCENTCLOUD_COS_REGION=ap-guangzhou
# public = 桶默认公网读 URL（桶需允许读）；presign = 短时预签名 GET URL（桶私有请用这个）
TENCENTCLOUD_UPLOAD_URL_MODE=public

# 可选：数据根目录（本仓库默认 ./data，一般无需改）
PIPELINE_DATA_ROOT=./data
